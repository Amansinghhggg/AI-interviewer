PORT=5000
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/db_name
JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRE=7d
CORS_ORIGIN=http://localhost:5173

# --- AI Provider Configuration ---
# Choose which question provider to use. Currently supported: 'gemini', 'static'
QUESTION_PROVIDER=gemini

# Choose which AI backend to use. Currently supported: 'gemini'
AI_PROVIDER=gemini

# Gemini API Key (Get one from Google AI Studio)
GEMINI_API_KEY=AQ.Ab8RN6LOy3QAPr1npHgsMDhiZ9nlyIbIjPYtcIswcUBavBvuxQ

# Gemini Model Selection (e.g. gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Generation Parameters
TEMPERATURE=0.7
MAX_OUTPUT_TOKENS=2048

# Request Timeout in milliseconds
REQUEST_TIMEOUT=30000
